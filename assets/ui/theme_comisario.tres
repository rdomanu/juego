texture = ExtResource("6_tarj_n")
texture_margin_left = 20.0
texture_margin_top = 26.0
texture_margin_right = 34.0
texture_margin_bottom = 24.0
# Mismo motivo que PestanaConstruccion: `TarjetaObjeto` se usa a 84×84 fijos
# (`modo_construccion._construir_boton_con_icono`) y también a 112×48
# (`modo_disenador_entorno._boton_herramienta`) -- el margen de contenido tiene que caber en el más
# pequeño de los dos SIN depender del texture_margin (que en `sb_tarj_h`/`sb_tarj_s` supera los 84px
# de alto sumando ambos lados). Este es el defecto reportado ("el texto desborda las tarjetas").
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

