[sub_resource type="StyleBoxTexture" id="sb_pest_n"]
texture = ExtResource("2_pest_n")
texture_margin_left = 23.0
texture_margin_top = 23.0
texture_margin_right = 29.0
texture_margin_bottom = 22.0
# content_margin_* SEPARADO de texture_margin_* (2026-08-08): texture_margin protege el arte de la
# esquina/halo del 9-slice (grande a propósito, hasta 45px en el estado hover con glow) pero estos
# botones se usan a tamaño FIJO y pequeño (112×74 en `modo_construccion._construir_pestana_categoria`).
# Sin este override, Godot usa texture_margin también como margen de contenido y el icono+rótulo
# quedaban sin sitio (hasta con área NEGATIVA en el estado hover) -- de ahí el texto desbordado.
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0

