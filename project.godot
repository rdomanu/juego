; PRODUCCION — Comisario
; Proyecto Godot de PRODUCCION. La raiz del repo = raiz del proyecto (res:// = repo root).
; Codigo de juego en src/ (por capas), tests en tests/. Escrito DESDE CERO — NO migra del
; prototipo (prototypes/comisaria-vertical-slice/ es solo referencia de diseno).
; Formato verificado para Godot 4.6 (config_version=5, features "GL Compatibility").
; En Godot se abre con IMPORT (no "New Project": 4.6 bloquea crear proyecto en carpeta no vacia).

config_version=5

[application]

config/name="Comisario"
run/main_scene="res://src/main/Main.tscn"
config/description="Tycoon de gestion de una comisaria del CNP (Godot 4.6, 2D top-down)."
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

; 1600x900 (2026-07-30, conversion a ISOMETRICO): el tablero de 24x13 celdas ocupa
; (24+13) x 80/2 = 1480 px de ancho y 740 de alto en rombo isometrico 80x40 — no cabia
; en los 1152x648 anteriores. Se agranda la ventana en vez de encoger el rombo para no
; bajar la resolucion del arte, que el art bible ya fijo en 80x40 (§8).
window/size/viewport_width=1600
window/size/viewport_height=900

[autoload]

EventBus="*res://src/foundation/event_bus/event_bus.gd"
RNGService="*res://src/foundation/rng_service/rng_service.gd"
Datos="*res://src/foundation/datos/datos.gd"
Tiempo="*res://src/foundation/tiempo/tiempo.gd"
SaveManager="*res://src/foundation/save_manager/save_manager.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
